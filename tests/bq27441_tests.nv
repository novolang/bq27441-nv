@test
fn test_the_battery_is_the_voltage_current_phase_and_percent() [io]
    let c = chip()
    let d = dut(c)
    put(c, 0x04, 3900)
    put(c, 0x10, 450)
    put(c, 0x1C, 61)
    // Charging: a current into the cell.
    let b = bq27441.battery_read(d) ?? BatteryReading { voltage: MilliVolts { mv: 0 },
        current: MilliAmps { ma: 0 },
        charge: ChargeState.ChargeIdle,
        percent: None }
    test.assert_eq(b.voltage.mv, 3900)
    test.assert_eq(b.current.ma, 450)
    test.assert(b.charge == ChargeState.ChargeConstantCurrent)
    test.assert(b.percent == Some(61))
    // Four reads: Flags, Voltage, AverageCurrent, StateOfCharge.
    log_clear(c)
    let _ = bq27441.battery_read(d)
    test.assert(log_list(c) == [2, 0x06, 2, 2, 0x04, 2, 2, 0x10, 2, 2, 0x1C, 2])
    // Discharging: negative current, idle.
    put(c, 0x10, 0xFE0C)
    let e = bq27441.battery_read(d) ?? b
    test.assert_eq(e.current.ma, -500)
    test.assert(e.charge == ChargeState.ChargeIdle)
    // Full charge detected.
    c.st.insert(30, 0x0208)
    put(c, 0x10, 5)
    let f = bq27441.battery_read(d) ?? b
    test.assert(f.charge == ChargeState.ChargeDone)

@test
fn test_no_battery_detected_is_none() [io]
    let c = chip()
    let d = dut(c)
    c.st.insert(30, 0)
    test.assert(bq27441.battery_read(d) == None)
    test.assert(bq27441.battery_read(dut(absent())) == None)
    // Each later read failing.
    c.st.insert(30, 0x0008)
    c.deaf.insert(0x04, 1)
    test.assert(bq27441.battery_read(d) == None)
    c.deaf.insert(0x04, 0)
    c.deaf.insert(0x10, 1)
    test.assert(bq27441.battery_read(d) == None)
    c.deaf.insert(0x10, 0)
    c.deaf.insert(0x1C, 1)
    test.assert(bq27441.battery_read(d) == None)

@test
fn test_the_mode_subcommands_send_their_codes() [io]
    let c = chip()
    let d = dut(c)
    let codes = [[0x000C, 1], [0x000D, 0]]
    log_clear(c)
    test.assert(bq27441.battery_present(d, true))
    test.assert(bq27441.battery_present(d, false))
    test.assert(bq27441.hibernate_allow(d, true))
    test.assert(bq27441.hibernate_allow(d, false))
    test.assert(bq27441.shutdown(d))
    test.assert(bq27441.pulse_gpout(d))
    test.assert(bq27441.reset_full(d))
    // The low bytes sent, in order: BAT_INSERT, BAT_REMOVE, SET_HIBERNATE,
    // CLEAR_HIBERNATE, SHUTDOWN_ENABLE, SHUTDOWN, TOGGLE_GPOUT, RESET.
    let l = log_list(c)
    var lows: [Int] = []
    var i = 0
    while i < l.len()
        if l[i + 1] == 0
            list.push(lows, l[i + 2])
        i = i + 3
    test.assert(lows == [0x0C, 0x0D, 0x11, 0x12, 0x1B, 0x1C, 0x23, 0x41])
    test.assert_eq(codes.len(), 2)
    test.assert_eq(at(c.st, 31), 1)

// ── The data memory ──────────────────────────────────────────────────

@test
fn test_a_data_memory_field_is_most_significant_byte_first() [io]
    let c = chip()
    let d = dut(c)
    test.assert_eq(bq27441.dm_read_word(d, 82, 10) ?? -1, 1000)
    // The block read: the control, the class and the block are written,
    // then the checksum and the 32 bytes are read.
    log_clear(c)
    let _ = bq27441.dm_read_word(d, 82, 10)
    test.assert(log_list(c) == [1, 0x61, 0, 1, 0x3E, 82, 1, 0x3F, 0, 2, 0x60, 1, 2, 0x40, 32])
    // The 5 ms pause after the block is selected.
    test.assert_eq(at(c.st, 90), 10)
    // An offset that leaves the field across two blocks, a negative one.
    test.assert(bq27441.dm_read_word(d, 82, 31) == None)
    test.assert(bq27441.dm_read_word(d, 82, -1) == None)
    // The second block of a class: offset 32 is byte 0 of block 1.
    dm_word(c, 82, 40, 0x1234)
    test.assert_eq(bq27441.dm_read_word(d, 82, 40) ?? -1, 0x1234)
    // A sealed part refuses the selection.
    c.st.insert(24, 1)
    test.assert(bq27441.dm_read_word(d, 82, 10) == None)
    test.assert(bq27441.dm_read_word(dut(absent()), 82, 10) == None)
    // The checksum answers and the block data does not.
    c.st.insert(24, 0)
    c.deaf.insert(0x40, 1)
    test.assert(bq27441.dm_read_word(d, 82, 10) == None)

@test
fn test_a_block_that_does_not_match_its_checksum_is_not_used() [io]
    let c = chip()
    let d = dut(c)
    c.st.insert(43, 1)
    test.assert(bq27441.dm_read_word(d, 82, 10) == None)
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1200), -3)
    // Nothing was written to the data memory or the block.
    test.assert_eq(dm_get(c, 82, 10), 1000)
    let l = log_list(c)
    test.assert(list.is_empty(writes_in(l, 0x40, 0x60)))

@test
fn test_a_field_is_written_with_its_new_checksum() [io]
    let c = chip()
    let d = dut(c)
    // The manual's example: the sum replacement and the part agree.
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1200), 1)
    test.assert_eq(dm_get(c, 82, 10), 1200)
    // The bytes written are the field's two, then the checksum.
    log_clear(c)
    test.assert_eq(bq27441.dm_write_word(d, 82, 12, 0x1234), 1)
    let l = log_list(c)
    let wr = writes_in(l, 0x40, 0x60)
    // The two data bytes at 0x40 + 12, then the checksum register 0x60,
    // then the reselection of the block for the read back.
    test.assert_eq(wr[0], 0x4C)
    test.assert_eq(wr[1], 0x12)
    test.assert_eq(wr[2], 0x4D)
    test.assert_eq(wr[3], 0x34)
    test.assert_eq(wr[4], 0x60)
    // The 10 ms settle was paused.
    test.assert(at(c.st, 90) >= 10)
    // Written again: unchanged, nothing sent to the block.
    log_clear(c)
    test.assert_eq(bq27441.dm_write_word(d, 82, 12, 0x1234), 0)
    let m = log_list(c)
    test.assert(list.is_empty(writes_in(m, 0x40, 0x60)))

@test
fn test_a_write_is_refused_where_it_cannot_be_done() [io]
    let c = chip()
    let d = dut(c)
    test.assert_eq(bq27441.dm_write_word(d, 82, 31, 5), -6)
    test.assert_eq(bq27441.dm_write_word(d, 82, -1, 5), -6)
    // The part ignores the checksum: the read back differs.
    c.st.insert(42, 1)
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1200), -4)
    c.st.insert(42, 0)
    // Sealed: the selection is refused.
    c.st.insert(24, 1)
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1200), -1)
    c.st.insert(24, 0)
    test.assert_eq(bq27441.dm_write_word(dut(absent()), 82, 10, 1200), -1)
    // A byte write refused.
    c.mute.insert(0x4B, 1)
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1200), -1)
    c.mute.insert(0x4B, 0)
    // The checksum write refused.
    c.mute.insert(0x60, 1)
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1200), -1)
    c.mute.insert(0x60, 0)
    // The block cannot be reselected for the read back: the seventh write
    // is the first packet of the second selection.
    c.st.insert(95, 7)
    c.st.insert(96, 0)
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1300), -1)
    c.st.insert(95, 0)
    // The read back of the checksum does not answer: the second read of 0x60.
    c.st.insert(46, 2)
    c.st.insert(47, 0)
    test.assert_eq(bq27441.dm_write_word(d, 82, 10, 1400), -1)

// ── The configuration update ─────────────────────────────────────────

@test
fn test_the_configuration_update_writes_the_four_fields() [io]
    let c = chip()
    let d = dut(c)
    let cfg = Bq27441Config { design_mah: 1200,
        design_mwh: 4440,
        terminate_mv: 3000,
        taper_rate: 80,
        opconfig: None }
    test.assert_eq(bq27441.config_update(d, cfg, bq27441.EXIT_SOFT_RESET), 4)
    test.assert_eq(dm_get(c, 82, 10), 1200)
    test.assert_eq(dm_get(c, 82, 12), 4440)
    test.assert_eq(dm_get(c, 82, 16), 3000)
    test.assert_eq(dm_get(c, 82, 27), 80)
    // Entered CONFIG UPDATE mode and left it by SOFT_RESET; unsealed to
    // begin with, so not sealed after.
    test.assert_eq(at(c.st, 32), 0)
    test.assert_eq(at(c.st, 24), 0)
    test.assert_eq(at(c.st, 21), 0x0042)
    // The same configuration again changes nothing.
    test.assert_eq(bq27441.config_update(d, cfg, bq27441.EXIT_SOFT_RESET), 0)
    // The terminate voltage and the taper rate are written when they differ,
    // and OpConfig when it is given.
    let cfg2 = Bq27441Config { design_mah: 1200,
        design_mwh: 4440,
        terminate_mv: 3100,
        taper_rate: 90,
        opconfig: Some(0x25FC) }
    test.assert_eq(bq27441.config_update(d, cfg2, bq27441.EXIT_RESIM), 3)
    test.assert_eq(dm_get(c, 82, 16), 3100)
    test.assert_eq(dm_get(c, 82, 27), 90)
    test.assert_eq(dm_get(c, 64, 0), 0x25FC)
    test.assert_eq(at(c.st, 21), 0x0044)
    let cfg3 = Bq27441Config { design_mah: 1200,
        design_mwh: 4440,
        terminate_mv: 3100,
        taper_rate: 90,
        opconfig: Some(0x25F8) }
    test.assert_eq(bq27441.config_update(d, cfg3, bq27441.EXIT_CFGUPDATE), 1)
    test.assert_eq(at(c.st, 21), 0x0043)

@test
fn test_a_sealed_part_is_unsealed_for_the_update_and_sealed_after() [io]
    let c = chip()
    c.st.insert(24, 1)
    let d = dut(c)
    test.assert_eq(bq27441.config_update(d, bq27441.config_for(1200, 4440), bq27441.EXIT_SOFT_RESET), 2)
    test.assert_eq(dm_get(c, 82, 10), 1200)
    test.assert_eq(at(c.st, 24), 1)
    // The order: the key twice, SET_CFGUPDATE, the exit, SEALED.
    let l = log_list(c)
    let none: [Int] = []
    let subs = list.flat_map(list.range(0, l.len() / 3),
        k => (if l[3 * k] == 1 and l[3 * k + 1] == 0 then [l[3 * k + 2]] else none))
    test.assert(subs[0] == 0)
    test.assert_eq(subs[subs.len() - 1], 0x20)
    test.assert_eq(subs[subs.len() - 2], 0x42)

@test
fn test_the_update_polls_flags_for_the_mode() [io]
    let c = chip()
    let d = dut(c)
    // The mode never sets: -2, and the part is asked to leave it.
    c.st.insert(35, 1)
    test.assert_eq(bq27441.config_update(d, bq27441.config_for(1200, 4440), bq27441.EXIT_SOFT_RESET), -2)
    test.assert_eq(at(c.st, 21), 0x0042)
    // 100 polls, 25 ms apart.
    test.assert_eq(at(c.st, 90), 2500)
    // The mode never clears: -5.
    let e = chip()
    e.st.insert(36, 1)
    test.assert_eq(bq27441.config_update(dut(e), bq27441.config_for(1200, 4440), bq27441.EXIT_SOFT_RESET), -5)
    test.assert_eq(dm_get(e, 82, 10), 1200)

@test
fn test_an_error_inside_the_mode_still_leaves_it() [io]
    let c = chip()
    let d = dut(c)
    c.st.insert(43, 1)
    test.assert_eq(bq27441.config_update(d, bq27441.config_for(1200, 4440), bq27441.EXIT_SOFT_RESET), -3)
    test.assert_eq(at(c.st, 32), 0)
    test.assert_eq(at(c.st, 21), 0x0042)
    // Each field's failure is reported.
    let e = chip()
    e.st.insert(42, 1)
    test.assert_eq(bq27441.config_update(dut(e), bq27441.config_for(1200, 4440), bq27441.EXIT_SOFT_RESET), -4)

@test
fn test_each_field_failing_after_the_first_is_reported() [io]
    // Only the field k differs from the part, and the part ignores the
    // checksum, so its read back differs.
    for k in 0..5
        let c = chip()
        let d = dut(c)
        var mah = 1000
        var mwh = 3800
        var mv = 3200
        var taper = 100
        var op: ?Int = None
        if k == 0
            mah = 1100
        if k == 1
            mwh = 3900
        if k == 2
            mv = 3100
        if k == 3
            taper = 90
        if k == 4
            op = Some(0x25FC)
        let cfg = Bq27441Config { design_mah: mah,
            design_mwh: mwh,
            terminate_mv: mv,
            taper_rate: taper,
            opconfig: op }
        c.st.insert(42, 1)
        test.assert_eq(bq27441.config_update(d, cfg, bq27441.EXIT_SOFT_RESET), -4)

@test
fn test_the_update_reports_a_gauge_that_stops_answering() [io]
    let cfg = bq27441.config_for(1200, 4440)
    test.assert_eq(bq27441.config_update(dut(absent()), cfg, 0), -1)
    // The writes of a whole update are 2 for CONTROL_STATUS, 4 for the key
    // when sealed, 2 for SET_CFGUPDATE, 9 for each of two changed fields and
    // 3 for each of two unchanged ones, 2 for the exit and 2 for SEALED.
    // The key is refused after its first packet.
    let a = chip()
    a.st.insert(24, 1)
    a.st.insert(95, 3 + 1)
    test.assert_eq(bq27441.config_update(dut(a), cfg, 0), -1)
    // SET_CFGUPDATE is refused.
    let b = chip()
    b.st.insert(95, 2 + 1)
    test.assert_eq(bq27441.config_update(dut(b), cfg, 0), -1)
    // The exit is refused: 2 + 2 + 24 writes come before it.
    let e = chip()
    e.st.insert(95, 28 + 1)
    test.assert_eq(bq27441.config_update(dut(e), cfg, 0), -1)
    // Sealing again is refused: 2 + 4 + 2 + 24 + 2 come before it.
    let f = chip()
    f.st.insert(24, 1)
    f.st.insert(95, 34 + 1)
    test.assert_eq(bq27441.config_update(dut(f), cfg, 0), -1)

// ── The awaitable GPOUT line ─────────────────────────────────────────

struct FakeEdge
    seen: HashMap<Int, Int>
    refuse: Int

impl AsyncEdge[] for FakeEdge
    fn edge_arm(self, pin: Int, edge: Int, f: Future) -> Int
        if self.refuse == 1
            return -2
        self.seen.insert(pin, edge)
        0

    fn edge_disarm(self, pin: Int) -> Bool
        self.seen.insert(pin + 1000, 1)
        true

    fn edge_irqs(self) -> Int
        0

@test
fn test_the_gpout_line_is_armed_for_a_falling_edge() [io, async]
    let f = core.rt.future_new()
    let e = FakeEdge { seen: HashMap.new(), refuse: 0 }
    test.assert_eq(bq27441.alert_arm(e, W, f), 0)
    test.assert_eq(at(e.seen, 7), 1)
    test.assert(bq27441.alert_disarm(e, W))
    test.assert_eq(at(e.seen, 1007), 1)
    test.assert_eq(bq27441.alert_arm(e, dev_bus.wiring_i2c(0, 0x55), f), -1)
    test.assert(not bq27441.alert_disarm(e, dev_bus.wiring_i2c(0, 0x55)))
    test.assert_eq(bq27441.alert_arm(FakeEdge { seen: HashMap.new(), refuse: 1 }, W, f), -2)
    core.rt.future_drop(f)

// ── The host scheduler's async form ──────────────────────────────────

@test
fn test_the_async_form_waits_for_initialization_then_answers() [io, hw, time, async]
    let c = chip()
    put(c, 0x04, 3900)
    put(c, 0x1C, 80)
    // INITCOMP reads clear for two reads of CONTROL_STATUS.
    c.st.insert(26, 2)
    let h = bq27441.host_of(dut(c))
    let b = await h.battery_measure()
    test.assert_eq((b ?? BatteryReading { voltage: MilliVolts { mv: 0 },
        current: MilliAmps { ma: 0 },
        charge: ChargeState.ChargeIdle,
        percent: None }).voltage.mv,
    3900)

@test
fn test_the_async_form_gives_up_when_the_gauge_does_not_answer() [io, hw, time, async]
    let a = bq27441.host_of(dut(absent()))
    test.assert(await a.battery_measure() == None)
    // INITCOMP never sets: after the polls the battery is read anyway.
    let c = chip()
    c.st.insert(25, 0)
    let h = bq27441.host_of(dut(c))
    test.assert(await h.battery_measure() != None)

// ── The part on a board's handles ────────────────────────────────────

@test
fn test_the_type_over_the_host_s_board_handles_answers_as_absent_hardware() [io]
    // The host's board handles drive no hardware: every read fails.
    let g = Bq27441.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, W)
    test.assert(not g.begin())
    g.pause_ms(1)
    test.assert(g.needs_config() == None)
    test.assert_eq(g.configure(bq27441.config_for(1200, 4440)), -1)
    test.assert(g.voltage() == None)
    test.assert(g.current() == None)
    test.assert(g.soc() == None)
    test.assert(g.battery_capacity() == None)
    test.assert(g.battery_temperature() == None)
    test.assert(g.battery_health() == BatteryHealth.HealthUnknown)
    test.assert(g.flags() == None)
    test.assert_eq(g.gpout(), 0)
    test.assert(not g.seal())
    test.assert(not g.unseal())
    test.assert(g.battery() == None)
    test.assert(g.device_id() == None)
    test.assert(not g.device_probe(0x0421))
    // The PowerManager of a gauge: no rail.
    test.assert_eq(g.rail_count(), 0)
    test.assert(g.rail_state(0) == RailState.RailOff)
    test.assert(g.rail_voltage(0) == None)
    test.assert(g.rail_set_voltage(0, MilliVolts { mv: 3300 }) == None)
    test.assert(not g.rail_enable(0, true))
    test.assert(not g.rail_is_on(0))
    test.assert(g.rail_current(0) == None)
