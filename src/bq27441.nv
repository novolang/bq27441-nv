// bq27441 — TI's BQ27441-G1 system-side Impedance Track fuel gauge, on
// its I2C bus, as the battery side of devices-nv's `PowerManager` and as
// `Identifiable`.
//
// A fuel gauge reports how full a lithium cell is.  This part measures
// the cell's voltage, its temperature and, across a sense resistor, the
// current into and out of it, and runs TI's Impedance Track algorithm on
// them to give the state of charge and the capacity in mAh.  The facts
// below are from TI's "bq27441-G1 Technical Reference", SLUUAC9A, December
// 2013, revised May 2015, and TI's data sheet "bq27441-G1 System-Side
// Impedance Track Fuel Gauge", SLUSBH1C, November 2013, revised December
// 2014 (the brief of this package names it SLUSBH2); the sections and
// tables named are those documents'.
//
// The bus (data sheet 9.5.4).  The 7-bit address is fixed at 0x55 (0xAA
// to write, 0xAB to read).  Every command is a register address: the
// standard commands are 2-byte words, the low byte at the even address
// (Table 4-1), and a read is the address, a repeated start and the bytes.
// Fix kept: at more than 100 kHz the data sheet asks for individual
// 1-byte writes ("use individual 1-byte write commands for proper data
// flow control"), and a bus-free time of at least 66 us between all
// packets addressed to the part.  Zephyr's `bq274xx` writes a control
// subcommand as one 3-byte packet; this driver writes it as two 1-byte
// packets, register 0x00 then register 0x01, and a port that drives a
// board waits `GAP_US` after every packet.
//
// The standard commands (Table 4-1), read as a little-endian word:
//
//   0x00 Control          0x02 Temperature (0.1 K)   0x04 Voltage (mV)
//   0x06 Flags            0x08 NominalAvailableCapacity (mAh)
//   0x0A FullAvailableCapacity   0x0C RemainingCapacity   0x0E FullChargeCapacity
//   0x10 AverageCurrent (mA, signed)   0x12 StandbyCurrent   0x14 MaxLoadCurrent
//   0x18 AveragePower (mW, signed)     0x1C StateOfCharge (%)
//   0x1E InternalTemperature (0.1 K)   0x20 StateOfHealth (low byte %, high byte status)
//
// The extended commands (Table 5-1): OpConfig 0x3A, DesignCapacity 0x3C,
// DataClass 0x3E, DataBlock 0x3F, BlockData 0x40 to 0x5F, BlockDataChecksum
// 0x60, BlockDataControl 0x61.  The Control subcommands (Table 4-2) are
// named `CS_*` below.  Flags (Table 4-4) is a word whose low byte holds
// DSG 0, SOCF 1, SOC1 2, BAT_DET 3, CFGUPMODE 4, ITPOR 5 and OCVTAKEN 7, and
// whose high byte holds CHG 0, FC 1, UT 6 and OT 7.
//
// The data memory (chapter 6) is reached in 32-byte blocks: BlockDataControl
// is written 0x00, DataClass the subclass ID, DataBlock the block, and the
// bytes are at 0x40 to 0x5F.  Fix kept: a data memory field is stored
// most significant byte first ("Expect 0x03 0xE8" for 1000 mAh, Section
// 3.1), where the standard commands are least significant first; the
// `bq27441` crate (leftger/bq27441) names the difference in its helpers
// and Zephyr reads the field with `sys_get_be16`.  A block is written by
// writing the new bytes and then the block checksum, 255 minus the low 8
// bits of the sum of the 32 bytes, to 0x60; the part copies the bytes to
// RAM only when the checksum is right.  Fix kept: Zephyr waits 5 ms after
// selecting a block (subclasses 64 and 82) and after writing the checksum
// and the crate waits 10 ms before it reads the checksum back; `dm_*`
// below waits 5 ms and 10 ms.
//
// The configuration update (Section 3.1; `config_update`): unseal when
// sealed (the key 0x8000 written twice to Control, no other write between
// them); SET_CFGUPDATE; poll Flags until CFGUPMODE is set, which "may
// take up to 1 second"; for each parameter select its block, check the
// checksum read against the bytes read, write the new bytes and the new
// checksum, and read the checksum back; leave with SOFT_RESET, which
// takes an OCV reading and resimulates, or EXIT_RESIM or EXIT_CFGUPDATE;
// poll Flags until CFGUPMODE clears; seal again when it was sealed.  The
// part leaves the mode itself after about 240 seconds.
//
// Drivers read for their fixes, nothing ported: Zephyr's
// `drivers/sensor/ti/bq274xx`, the `bq27441` crate (leftger/bq27441,
// 0.3.0).  Each fix kept is named at its site.

use core.rt
use embedded_hal.{ BoardI2c, BoardTimer, BoardGpio, I2cBus, GpioOut, Timer, AsyncEdge }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_power.{ MilliVolts, MilliAmps, RailState, ChargeState, BatteryReading, PowerManager, PowerManagerAsync }
use dev_id.{ DeviceId, Identifiable }

// The standard and extended commands.
let CMD_CNTL   = 0x00
let CMD_TEMP   = 0x02
let CMD_VOLT   = 0x04
let CMD_FLAGS  = 0x06
let CMD_NAC    = 0x08
let CMD_FAC    = 0x0A
let CMD_RM     = 0x0C
let CMD_FCC    = 0x0E
let CMD_AI     = 0x10
let CMD_SI     = 0x12
let CMD_MLI    = 0x14
let CMD_AP     = 0x18
let CMD_SOC    = 0x1C
let CMD_ITEMP  = 0x1E
let CMD_SOH    = 0x20
let CMD_OPCONF = 0x3A
let CMD_DCAP   = 0x3C
let CMD_DCLASS = 0x3E
let CMD_DBLOCK = 0x3F
let BLOCK_DATA = 0x40
let CMD_CSUM   = 0x60
let CMD_DCTRL  = 0x61

// The Control subcommands (Table 4-2).

// CONTROL_STATUS: the status word (Table 4-3).
pub const CS_STATUS = 0x0000
// DEVICE_TYPE: the device type, 0x0421.
pub const CS_DEVICE_TYPE = 0x0001
// FW_VERSION: the firmware version.
pub const CS_FW_VERSION = 0x0002
// DM_CODE: the data memory code in the low byte.
pub const CS_DM_CODE = 0x0004
// CHEM_ID: the chemical identifier of the battery profile.
pub const CS_CHEM_ID = 0x0008
// BAT_INSERT: sets BAT_DET when OpConfig's BIE is clear.
pub const CS_BAT_INSERT = 0x000C
// BAT_REMOVE: clears BAT_DET when OpConfig's BIE is clear.
pub const CS_BAT_REMOVE = 0x000D
// SET_HIBERNATE: allows the HIBERNATE mode.
pub const CS_SET_HIBERNATE = 0x0011
// CLEAR_HIBERNATE: forbids it, and wakes the part.
pub const CS_CLEAR_HIBERNATE = 0x0012
// SET_CFGUPDATE: enters CONFIG UPDATE mode; unsealed only.
pub const CS_SET_CFGUPDATE = 0x0013
// SHUTDOWN_ENABLE: allows SHUTDOWN; unsealed only.
pub const CS_SHUTDOWN_ENABLE = 0x001B
// SHUTDOWN: enters SHUTDOWN; unsealed only.
pub const CS_SHUTDOWN = 0x001C
// SEALED: seals the part; unsealed only.
pub const CS_SEALED = 0x0020
// TOGGLE_GPOUT: pulses GPOUT for about 1 ms.
pub const CS_TOGGLE_GPOUT = 0x0023
// RESET: a full reset to the ROM defaults; unsealed only.
pub const CS_RESET = 0x0041
// SOFT_RESET: leaves CONFIG UPDATE mode with an OCV reading.
pub const CS_SOFT_RESET = 0x0042
// EXIT_CFGUPDATE: leaves the mode with no OCV reading and no resimulation.
pub const CS_EXIT_CFGUPDATE = 0x0043
// EXIT_RESIM: leaves the mode and resimulates, with no OCV reading.
pub const CS_EXIT_RESIM = 0x0044

// The key that unseals the part: 0x8000 written twice (Section 6.1.3).
let UNSEAL_KEY = 0x8000

// DEVICE_TYPE's answer (Section 4.1.2), also given by the -G1A and -G1B.
let DEVICE_TYPE = 0x0421

// CONTROL_STATUS' bits as the word: SS in the high byte, INITCOMP and
// HIBERNATE in the low (Table 4-3).
let CTRL_SS       = 0x2000
let CTRL_INITCOMP = 0x0080

// Flags' bits as the word (Table 4-4).

// Flags: discharging detected.
pub const FLAG_DSG = 0x0001
// Flags: the state of charge is at or below the SOCF threshold.
pub const FLAG_SOCF = 0x0002
// Flags: the state of charge is at or below the SOC1 threshold.
pub const FLAG_SOC1 = 0x0004
// Flags: a battery insertion is detected.
pub const FLAG_BAT_DET = 0x0008
// Flags: the part is in CONFIG UPDATE mode.
pub const FLAG_CFGUPMODE = 0x0010
// Flags: a power-on reset or RESET has put the RAM at the ROM defaults.
pub const FLAG_ITPOR = 0x0020
// Flags: an OCV reading was taken in relax mode.
pub const FLAG_OCVTAKEN = 0x0080
// Flags: fast charging is allowed.
pub const FLAG_CHG = 0x0100
// Flags: full charge is detected.
pub const FLAG_FC = 0x0200
// Flags: under-temperature.
pub const FLAG_UT = 0x4000
// Flags: over-temperature.
pub const FLAG_OT = 0x8000

// OpConfig's bits as the word (Table 6-7): BIE, BI_PU_EN and GPIOPOL in
// the high byte; SLEEP, RMFCC, BATLOWEN and TEMPS in the low.

// OpConfig: battery insertion is detected by the BIN pin.
pub const OPC_BIE = 0x2000
// OpConfig: the internal pull-up on the BIN pin.
pub const OPC_BI_PU_EN = 0x1000
// OpConfig: GPOUT is active high (clear: active low).
pub const OPC_GPIOPOL = 0x0800
// OpConfig: the part may enter SLEEP.
pub const OPC_SLEEP = 0x0020
// OpConfig: RM is set to FCC on a valid charge termination.
pub const OPC_RMFCC = 0x0010
// OpConfig: GPOUT shows BAT_LOW (clear: the SOC_INT pulse).
pub const OPC_BATLOWEN = 0x0004
// OpConfig: the host writes the temperature the algorithm uses.
pub const OPC_TEMPS = 0x0001

// The data memory parameters this driver writes: the State subclass, 82,
// whose offsets are in Table 6-3 (the -G1 offsets: Zephyr's `bq27421_regs`
// agrees), and the Registers subclass, 64, which holds OpConfig.
let DM_STATE          = 82
let DM_REGISTERS      = 64
let OFF_DESIGN_CAP    = 10
let OFF_DESIGN_ENERGY = 12
let OFF_TERMINATE_V   = 16
let OFF_TAPER_RATE    = 27
let OFF_OPCONFIG      = 0

// How a configuration update leaves the mode.

// Leave CONFIG UPDATE mode with SOFT_RESET: an OCV reading and a resimulation.
pub const EXIT_SOFT_RESET = 0
// Leave the mode with EXIT_RESIM: a resimulation.
pub const EXIT_RESIM = 1
// Leave the mode with EXIT_CFGUPDATE: neither.
pub const EXIT_CFGUPDATE = 2

// The pause after selecting a block and after writing a checksum, and the
// settle before the checksum is read back.
let DM_DELAY_MS  = 5
let DM_SETTLE_MS = 10

// Polls of CFGUPMODE, 25 ms apart: 2.5 s against the 1 s the manual gives.
let CFGUP_POLLS   = 100
let CFGUP_POLL_MS = 25

// The bus-free time after a packet, in microseconds (data sheet 9.5.4.3).
pub const GAP_US = 66

// The bus clock `setup` asks for: fast mode, 400 kHz.
let I2C_HZ = 400000

// The most 100 ms parks that `battery_measure` waits for INITCOMP, which
// "could take up to 10 seconds" (Section 2.4.6).
let INIT_POLLS = 100

// The values a configuration update writes.  `design_mah` is the cell's
// capacity (State subclass, offset 10), `design_mwh` its energy (12),
// `terminate_mv` the voltage at which it is empty (16) and `taper_rate`
// the charge taper in tenths of an hour rate, capacity x 10 / the taper
// current in mA (27).  `opconfig` is the OpConfig word to write, and
// `None` leaves OpConfig as it is.
pub @value
struct Bq27441Config
    design_mah: Int
    design_mwh: Int
    terminate_mv: Int
    taper_rate: Int
    opconfig: ?Int

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register as a 1-byte packet; `pause_ms` waits; `irq_level` answers the
// level of the GPOUT pin.  A port for a board waits `GAP_US` after every
// packet.
pub trait Bq27441Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn pause_ms(self, ms: Int) [hw]
    fn irq_level(self) -> Int [hw]

// ── The bus ──────────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction: whether
// the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` as one 1-byte packet: whether the part
// acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Makes the bus ready: the GPOUT pin an input with a pull-up (the pin is
// open-drain and active low unless OpConfig says otherwise), the bus at
// 400 kHz.  Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 2)
    bus.init(I2C_HZ)
    w.addr != None

// The level of the GPOUT line on the board, 1 or 0, or -1 for a wiring
// with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Words and conversions ────────────────────────────────────────────

// A command's 2-byte word, low byte first, or `None` when the part did not
// answer.
pub fn word_read<P: Bq27441Port>(p: P, cmd: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(cmd, 2, var b)
        return None
    Some((b[1] as Int << 8) | b[0] as Int)

// The signed value of a 16-bit word.
pub fn signed16(raw: Int) -> Int
    dev_bus.dev_sign_extend(raw, 16)

// A temperature word in tenths of a kelvin as millidegrees Celsius: one
// step is 100 millikelvin, and 0 degC is 273.15 K.
//
// ```novo
// use bq27441
//
// fn main() [io]
//     println("${bq27441.temp_milli_c(2982)}")   // 25050
//     println("${bq27441.temp_milli_c(2731)}")   // -50
// ```
pub fn temp_milli_c(raw: Int) -> Int
    (raw & 0xFFFF) * 100 - 273150

// The 255 minus the low 8 bits of the sum of the 32 bytes of a data
// memory block (Section 5.6).
pub fn block_checksum(b: DevBytes) -> Int
    var sum = 0
    for x in b
        sum = sum + x as Int
    255 - (sum & 0xFF)

// The block checksum after two bytes of the block change, by the manual's
// replacement method (Section 3.1, step 10): the old checksum is
// undone with the old bytes, and the new bytes are added.  `old_csum` is
// the checksum the part held, `old_hi` and `old_lo` the old bytes of the
// field, `new_hi` and `new_lo` the new ones.  Equal to `block_checksum` of
// the changed block.
//
// ```novo
// use bq27441
//
// fn main() [io]
//     // The manual's example: Design Capacity 1000 mAh (0x03E8) becomes
//     // 1200 mAh (0x04B0) in a block whose checksum was 0xE8.
//     println("${bq27441.checksum_after(0xE8, 0x03, 0xE8, 0x04, 0xB0)}")   // 31
// ```
pub fn checksum_after(old_csum: Int, old_hi: Int, old_lo: Int, new_hi: Int, new_lo: Int) -> Int
    let t = ((255 - old_csum - old_hi - old_lo) % 256 + 256) % 256
    255 - (t + new_hi + new_lo) % 256

// ── Control and status ───────────────────────────────────────────────

// Sends a Control subcommand as two 1-byte packets, the low byte to 0x00
// and the high byte to 0x01: whether both were acknowledged.
pub fn control_send<P: Bq27441Port>(p: P, sub: Int) -> Bool [hw]
    p.write_reg(CMD_CNTL, sub & 0xFF) and p.write_reg(CMD_CNTL + 1, (sub >> 8) & 0xFF)

// Sends a Control subcommand and reads its 2-byte answer from Control, or
// `None` when the part did not answer.
pub fn control_read<P: Bq27441Port>(p: P, sub: Int) -> ?Int [hw]
    if not control_send(p, sub)
        return None
    word_read(p, CMD_CNTL)

// The Flags word, or `None`.
pub fn flags_read<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_FLAGS)

// The CONTROL_STATUS word (Table 4-3), or `None`.
pub fn control_status<P: Bq27441Port>(p: P) -> ?Int [hw]
    control_read(p, CS_STATUS)

// Whether the part is sealed (CONTROL_STATUS' SS bit), or `None`.
pub fn is_sealed<P: Bq27441Port>(p: P) -> ?Bool [hw]
    let Some(cs) = control_status(p) else return None
    Some((cs & CTRL_SS) != 0)

// Unseals the part: the key 0x8000 written to Control twice, with no
// other write between them.  Whether both were acknowledged.
pub fn unseal<P: Bq27441Port>(p: P) -> Bool [hw]
    control_send(p, UNSEAL_KEY) and control_send(p, UNSEAL_KEY)

// Seals the part: the data memory commands and the writes to the standard
// ones are refused again.
pub fn seal<P: Bq27441Port>(p: P) -> Bool [hw]
    control_send(p, CS_SEALED)

// What the part says it is: `who` is DEVICE_TYPE, 0x0421, and `rev` the
// firmware version.  `None` when the part does not answer or answers
// another type.  The -G1A and -G1B answer 0x0421 as well; `chem_id` and
// `dm_code` tell them apart (Section 4.1.2).
pub fn identify<P: Bq27441Port>(p: P) -> ?DeviceId [hw]
    let Some(t) = control_read(p, CS_DEVICE_TYPE) else return None
    if t != DEVICE_TYPE
        return None
    Some(DeviceId { who: t, rev: control_read(p, CS_FW_VERSION) })

// The chemical identifier of the battery profile (Section 4.1.6): 0x0128
// for the -G1A and 0x0312 for the -G1B.
pub fn chem_id<P: Bq27441Port>(p: P) -> ?Int [hw]
    control_read(p, CS_CHEM_ID)

// The data memory code number in the low byte (Section 4.1.4).
pub fn dm_code<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(c) = control_read(p, CS_DM_CODE) else return None
    Some(c & 0xFF)

// Whether the part answers as a BQ27441 and has been brought out of its
// start-up: the bus is made ready and DEVICE_TYPE read.  The part needs
// 250 ms (typical) after power-up before it answers; the program waits
// that before it calls this.
pub fn start<P: Bq27441Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    identify(p) != None

// Whether the part reports a power-on reset or a RESET: Flags' ITPOR is
// set, the RAM configuration is back at the ROM defaults and the host
// should run `config_update` (Section 2.4.2).  `None` when the part did
// not answer.
pub fn needs_config<P: Bq27441Port>(p: P) -> ?Bool [hw]
    let Some(f) = flags_read(p) else return None
    Some((f & FLAG_ITPOR) != 0)

// ── Measurements ─────────────────────────────────────────────────────

// The cell voltage in millivolts, or `None`.
pub fn voltage_mv<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_VOLT)

// The cell temperature in millidegrees Celsius, from the sensor
// OpConfig's TEMPS selects, or `None`.
pub fn temperature_milli_c<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(t) = word_read(p, CMD_TEMP) else return None
    Some(temp_milli_c(t))

// The gauge's internal temperature in millidegrees Celsius, or `None`.
pub fn internal_temp_milli_c<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(t) = word_read(p, CMD_ITEMP) else return None
    Some(temp_milli_c(t))

// The average current in milliamps, signed: positive into the cell while
// it charges, negative while it discharges.  Updated once a second.
pub fn current_ma<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(c) = word_read(p, CMD_AI) else return None
    Some(signed16(c))

// The standby current in milliamps, signed.
pub fn standby_current_ma<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(c) = word_read(p, CMD_SI) else return None
    Some(signed16(c))

// The maximum load current in milliamps, signed.
pub fn max_load_current_ma<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(c) = word_read(p, CMD_MLI) else return None
    Some(signed16(c))

// The average power in milliwatts, signed: negative while discharging.
pub fn power_mw<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(c) = word_read(p, CMD_AP) else return None
    Some(signed16(c))

// The state of charge in percent, or `None`.  The part holds it to 0
// to 100.
pub fn soc_percent<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_SOC)

// The remaining capacity, compensated for load and temperature, in mAh.
pub fn remaining_mah<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_RM)

// The full-charge capacity, compensated, in mAh.
pub fn full_charge_mah<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_FCC)

// The uncompensated remaining capacity (light load), in mAh.
pub fn nominal_available_mah<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_NAC)

// The uncompensated full capacity, in mAh.
pub fn full_available_mah<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_FAC)

// The state of health in percent, 0 to 100 (the low byte of the word), or
// `None`.  The high byte is the status; `soh_status` reads it.
pub fn soh_percent<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(w) = word_read(p, CMD_SOH) else return None
    Some(w & 0xFF)

// The state-of-health status: 0 not valid, 1 instant value ready, 2
// initial value ready, 3 value ready (Section 4.15), or `None`.
pub fn soh_status<P: Bq27441Port>(p: P) -> ?Int [hw]
    let Some(w) = word_read(p, CMD_SOH) else return None
    Some((w >> 8) & 0xFF)

// The OpConfig word from the extended command (Section 5.1), available
// sealed, or `None`.  Read as the other commands are, low byte first;
// NOT VERIFIED against a part.
pub fn opconfig_read<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_OPCONF)

// The Design Capacity from the extended command (Section 5.2), in mAh,
// available sealed, or `None`.
pub fn design_capacity_mah<P: Bq27441Port>(p: P) -> ?Int [hw]
    word_read(p, CMD_DCAP)

// The measurement `PowerManager.battery` answers: the voltage, the average
// current, the phase and the state of charge, in four reads (Flags,
// Voltage, AverageCurrent and StateOfCharge).  `None` when the part does
// not answer, and when BAT_DET is clear: "gauge predictions are not valid
// unless [BAT_DET] is set" (Table 4-4).  The part does not know a
// charger's phase: a full cell (FC) is `ChargeDone`, a current into the
// cell is `ChargeConstantCurrent`, the phase `dev_power.power_is_charging`
// counts first, and any other state `ChargeIdle`.
//
// The data sheet (9.5.4.3) limits how often a host may issue standard
// commands; its sentence is garbled in the copy read ("must not issue any
// standard command more than two times per second"), and this driver does
// not limit them.  NOT VERIFIED.
pub fn battery_read<P: Bq27441Port>(p: P) -> ?BatteryReading [hw]
    let Some(fl) = flags_read(p) else return None
    if (fl & FLAG_BAT_DET) == 0
        return None
    let Some(mv) = voltage_mv(p) else return None
    let Some(ma) = current_ma(p) else return None
    let Some(soc) = soc_percent(p) else return None
    var phase = ChargeState.ChargeIdle
    if (fl & FLAG_FC) != 0
        phase = ChargeState.ChargeDone
    elif ma > 0
        phase = ChargeState.ChargeConstantCurrent
    Some(BatteryReading { voltage: MilliVolts { mv: mv },
        current: MilliAmps { ma: ma },
        charge: phase,
        percent: Some(soc) })

// ── Modes ────────────────────────────────────────────────────────────

// Tells the part a battery is present (BAT_INSERT), for OpConfig's BIE
// clear; and gone (BAT_REMOVE).  Whether the part acknowledged.
pub fn battery_present<P: Bq27441Port>(p: P, present: Bool) -> Bool [hw]
    if present
        return control_send(p, CS_BAT_INSERT)
    control_send(p, CS_BAT_REMOVE)

// Allows or forbids the HIBERNATE mode (SET_HIBERNATE, CLEAR_HIBERNATE).
pub fn hibernate_allow<P: Bq27441Port>(p: P, on: Bool) -> Bool [hw]
    if on
        return control_send(p, CS_SET_HIBERNATE)
    control_send(p, CS_CLEAR_HIBERNATE)

// Puts the part in SHUTDOWN: SHUTDOWN_ENABLE, then SHUTDOWN.  The part
// wakes when GPOUT is raised for at least 200 us (Section 2.4.1).
pub fn shutdown<P: Bq27441Port>(p: P) -> Bool [hw]
    control_send(p, CS_SHUTDOWN_ENABLE) and control_send(p, CS_SHUTDOWN)

// Pulses GPOUT for about 1 ms (TOGGLE_GPOUT), for a test of the line; the
// pin must be in its SOC_INT function.
pub fn pulse_gpout<P: Bq27441Port>(p: P) -> Bool [hw]
    control_send(p, CS_TOGGLE_GPOUT)

// A full reset: RAM returns to the ROM defaults and ITPOR is set (Section
// 4.1.16).  Only available unsealed.  Whether the part acknowledged.
pub fn reset_full<P: Bq27441Port>(p: P) -> Bool [hw]
    control_send(p, CS_RESET)

// ── The data memory ──────────────────────────────────────────────────

// Selects block `block` of the subclass `class`: BlockDataControl 0x00,
// DataClass, DataBlock, then the pause.  Whether the three packets were
// acknowledged.
fn dm_select<P: Bq27441Port>(p: P, class: Int, block: Int) -> Bool [hw]
    if not (p.write_reg(CMD_DCTRL, 0) and p.write_reg(CMD_DCLASS, class) and p.write_reg(CMD_DBLOCK, block))
        return false
    p.pause_ms(DM_DELAY_MS)
    true

// Reads the 32 bytes of a block into `dst` and answers the checksum the
// part holds, 0 to 255; -1 when the part did not answer and -3 when the
// checksum does not match the bytes, which is a block read mid-update or
// a bus fault.  The block must have been selected.
fn dm_load<P: Bq27441Port>(p: P, var dst: DevBytes) -> Int [hw]
    var c: DevBytes = Vec.new()
    if not p.read_regs(CMD_CSUM, 1, var c)
        return -1
    if not p.read_regs(BLOCK_DATA, 32, var dst)
        return -1
    if block_checksum(dst) != (c[0] as Int)
        return -3
    c[0] as Int

// The data memory field of 16 bits at `offset` of the subclass `class`,
// most significant byte first, or `None`.  The offset must leave the whole
// field in one block (an offset of 31 does not).  The part must be
// unsealed.
pub fn dm_read_word<P: Bq27441Port>(p: P, class: Int, offset: Int) -> ?Int [hw]
    if offset < 0 or offset % 32 > 30
        return None
    if not dm_select(p, class, offset / 32)
        return None
    var b: DevBytes = Vec.new()
    if dm_load(p, var b) < 0
        return None
    let i = offset % 32
    Some((b[i] as Int << 8) | b[i + 1] as Int)

// Writes the 16-bit data memory field at `offset` of the subclass `class`,
// most significant byte first.  The part must be unsealed and in CONFIG
// UPDATE mode.  Answers 1 when it wrote the field, 0 when the field
// already held the value and nothing was written (Zephyr's
// `bq274xx_update_block` skips an unchanged field too), and a negative
// code otherwise: -1 the part did not answer, -3 the block read did not
// match its checksum, -4 the checksum read back after the write differs
// from the one written, -6 the offset leaves the field across two blocks.
pub fn dm_write_word<P: Bq27441Port>(p: P, class: Int, offset: Int, value: Int) -> Int [hw]
    if offset < 0 or offset % 32 > 30
        return -6
    let block = offset / 32
    let i = offset % 32
    if not dm_select(p, class, block)
        return -1
    var old: DevBytes = Vec.new()
    let csum = dm_load(p, var old)
    if csum < 0
        return csum
    let old_hi = old[i] as Int
    let old_lo = old[i + 1] as Int
    let hi = (value >> 8) & 0xFF
    let lo = value & 0xFF
    if hi == old_hi and lo == old_lo
        return 0
    let next = checksum_after(csum, old_hi, old_lo, hi, lo)
    if not (p.write_reg(BLOCK_DATA + i, hi) and p.write_reg(BLOCK_DATA + i + 1, lo))
        return -1
    if not p.write_reg(CMD_CSUM, next)
        return -1
    p.pause_ms(DM_SETTLE_MS)
    if not dm_select(p, class, block)
        return -1
    var back: DevBytes = Vec.new()
    let got = dm_load(p, var back)
    if got < 0
        return got
    if got != next or (back[i] as Int) != hi or (back[i + 1] as Int) != lo
        return -4
    1

// ── The configuration update ─────────────────────────────────────────

// Waits for CFGUPMODE to read `want` (true set, false clear), polling
// Flags every 25 ms at most 100 times: whether it did.
fn cfgup_wait<P: Bq27441Port>(p: P, want: Bool) -> Bool [hw]
    for _i in 0..CFGUP_POLLS
        let Some(f) = flags_read(p) else return false
        if ((f & FLAG_CFGUPMODE) != 0) == want
            return true
        p.pause_ms(CFGUP_POLL_MS)
    false

// The subcommand that leaves CONFIG UPDATE mode for an `EXIT_*` choice.
fn exit_sub(exit: Int) -> Int
    if exit == EXIT_RESIM
        return CS_EXIT_RESIM
    if exit == EXIT_CFGUPDATE
        return CS_EXIT_CFGUPDATE
    CS_SOFT_RESET

// Writes the fields of `cfg` that differ from the part's, inside CONFIG
// UPDATE mode: the design capacity, the design energy, the terminate
// voltage and the taper rate of the State subclass, and OpConfig of the
// Registers subclass when `cfg` has one.  Answers how many it wrote, or
// the first negative code of `dm_write_word`.
fn cfg_write<P: Bq27441Port>(p: P, cfg: Bq27441Config) -> Int [hw]
    var wrote = 0
    let a = dm_write_word(p, DM_STATE, OFF_DESIGN_CAP, cfg.design_mah)
    if a < 0
        return a
    let b = dm_write_word(p, DM_STATE, OFF_DESIGN_ENERGY, cfg.design_mwh)
    if b < 0
        return b
    let c = dm_write_word(p, DM_STATE, OFF_TERMINATE_V, cfg.terminate_mv)
    if c < 0
        return c
    let d = dm_write_word(p, DM_STATE, OFF_TAPER_RATE, cfg.taper_rate)
    if d < 0
        return d
    wrote = a + b + c + d
    if let Some(op) = cfg.opconfig
        let e = dm_write_word(p, DM_REGISTERS, OFF_OPCONFIG, op)
        if e < 0
            return e
        wrote = wrote + e
    wrote

// The configuration update of the manual's Section 3.1: unseal when
// sealed, enter CONFIG UPDATE mode, write the fields of `cfg`, leave the
// mode by `exit` (an `EXIT_*` choice), and seal again when the part was
// sealed.  Answers the number of fields written, 0 to 5, or a negative
// code: -1 the part did not answer, -2 CFGUPMODE did not set within the
// polls, -3 a block did not match its checksum, -4 a checksum read back
// differently, -5 CFGUPMODE did not clear.  After an error inside the mode
// the part is asked to leave it, so it is not left without gauging until
// its 240 second time-out.
//
// Fix kept: a field that already holds the value is not written, and the
// checksum is computed from the bytes read and checked against the one the
// part holds before anything is written, so a block read half-updated is
// not written back.
pub fn config_update<P: Bq27441Port>(p: P, cfg: Bq27441Config, exit: Int) -> Int [hw]
    let Some(sealed) = is_sealed(p) else return -1
    if sealed and not unseal(p)
        return -1
    if not control_send(p, CS_SET_CFGUPDATE)
        return -1
    if not cfgup_wait(p, true)
        let _ = control_send(p, CS_SOFT_RESET)
        return -2
    let wrote = cfg_write(p, cfg)
    if not control_send(p, exit_sub(exit))
        return -1
    if not cfgup_wait(p, false)
        return -5
    if sealed and not seal(p)
        return -1
    wrote

// A configuration for a cell of `mah` milliamp-hours and `mwh`
// milliwatt-hours: terminate voltage 3200 mV, the manual's default, taper
// rate for a taper current of C/10, and OpConfig left alone.
//
// ```novo
// use bq27441
//
// fn main() [io]
//     let c = bq27441.config_for(1200, 4440)
//     println("${c.taper_rate}")   // 100
// ```
pub fn config_for(mah: Int, mwh: Int) -> Bq27441Config
    Bq27441Config { design_mah: mah,
        design_mwh: mwh,
        terminate_mv: 3200,
        taper_rate: 100,
        opconfig: None }

// ── The awaitable GPOUT line ─────────────────────────────────────────

// Arms the GPOUT line on a pin-edge source: the Future `f` resolves with
// the level captured when the line falls, which is the part's alert or
// state-of-charge pulse with OpConfig's GPIOPOL clear, its default.  `edge`
// is any implementation of embedded-hal-nv's `AsyncEdge`; no board's GPIO
// implements it today.  The caller makes `f` with `core.rt.future_new` and
// awaits it with `core.rt.future_await`, then reads `flags_read`.  Answers
// 0 when armed, and -1 when the wiring has no interrupt pin or the source
// refused.
pub fn alert_arm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring, f: Future) -> Int [e]
    let Some(irq) = w.irq else return -1
    edge.edge_arm(irq, 1, f)

// Takes the arm back: whether it was still armed.  See `AsyncEdge`.
pub fn alert_disarm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring) -> Bool [e]
    let Some(irq) = w.irq else return false
    edge.edge_disarm(irq)

// ── The part on a board ──────────────────────────────────────────────

// A BQ27441-G1 on a board's I2C bus at the address `w.addr`, 0x55, with
// the board's timer for the bus-free time and the waits, and its GPIO for
// the GPOUT line.
pub @value
struct Bq27441
    bus: BoardI2c
    timer: BoardTimer
    pins: BoardGpio
    w: DeviceWiring

impl Bq27441Port for Bq27441
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        let ok = i2c_read_into(self.bus, self.w, reg, n, var dst)
        self.timer.delay_us(GAP_US)
        ok

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        let ok = i2c_write(self.bus, self.w, reg, v)
        self.timer.delay_us(GAP_US)
        ok

    fn pause_ms(self, ms: Int) [hw]
        self.timer.delay_ms(ms)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Bq27441
    // The part at `w.addr` on the board's bus, as a board's device table
    // builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, timer: BoardTimer, pins: BoardGpio, w: DeviceWiring) -> Bq27441
        Bq27441 { bus: bus, timer: timer, pins: pins, w: w }

    // Makes the bus ready and checks DEVICE_TYPE (`start`).  The part is
    // powered at least 250 ms before this.
    fn begin(self) -> Bool [hw]
        start(self)

    // Whether the RAM configuration is back at the ROM defaults (ITPOR).
    fn needs_config(self) -> ?Bool [hw]
        needs_config(self)

    // Writes the configuration (`config_update`).
    fn configure(self, cfg: Bq27441Config) -> Int [hw]
        config_update(self, cfg, EXIT_SOFT_RESET)

    // The voltage in millivolts.
    fn voltage(self) -> ?Int [hw]
        voltage_mv(self)

    // The average current in milliamps, positive into the cell.
    fn current(self) -> ?Int [hw]
        current_ma(self)

    // The state of charge in percent.
    fn soc(self) -> ?Int [hw]
        soc_percent(self)

    // The remaining capacity in mAh.
    fn remaining(self) -> ?Int [hw]
        remaining_mah(self)

    // The cell temperature in millidegrees Celsius.
    fn temperature(self) -> ?Int [hw]
        temperature_milli_c(self)

    // The Flags word.
    fn flags(self) -> ?Int [hw]
        flags_read(self)

    // The level of the GPOUT line, -1 for a wiring with none.
    fn gpout(self) -> Int [hw]
        self.irq_level()

    // Seals the part.
    fn seal(self) -> Bool [hw]
        seal(self)

    // Unseals the part.
    fn unseal(self) -> Bool [hw]
        unseal(self)

impl PowerManager[hw] for Bq27441
    // The part supplies no rail.
    fn rail_count(self) -> Int [hw]
        0

    // A rail the part does not have is off.
    fn rail_state(self, rail: Int) -> RailState [hw]
        RailState.RailOff

    fn rail_voltage(self, rail: Int) -> ?MilliVolts [hw]
        None

    fn rail_set_voltage(self, rail: Int, v: MilliVolts) -> ?MilliVolts [hw]
        None

    fn rail_enable(self, rail: Int, on: Bool) -> Bool [hw]
        false

    // The voltage, the average current, the phase and the state of charge;
    // `None` while no battery is detected.
    fn battery(self) -> ?BatteryReading [hw]
        battery_read(self)

impl Identifiable[hw] for Bq27441
    // DEVICE_TYPE, 0x0421, with the firmware version as `rev`.
    fn device_id(self) -> ?DeviceId [hw]
        identify(self)

// ── The host scheduler's async form ──────────────────────────────────

// A part on the host scheduler, which implements `PowerManagerAsync`:
// `battery_measure` waits for the gauge's initialization to complete
// (CONTROL_STATUS' INITCOMP, which "could take up to 10 seconds" after a
// power-up or a wake from HIBERNATE) by parking the task, and then answers
// the battery.  `dev` is any `Bq27441Port`.  The struct is not a `@value`
// struct, since an `async fn` takes none (SPEC § 14.5) and a struct with a
// generic field cannot be one; `host_of` builds it as one cell of the
// arena.  The impl is `@tier(app)`: the embedded tier refuses an `async
// fn` (E4002).  On a device the awaitable form is `alert_arm`.
pub struct Bq27441Host<P: Bq27441Port>
    dev: P

// The host-scheduler form of the part `dev`.
pub @tier(app)
fn host_of<P: Bq27441Port>(dev: P) -> Bq27441Host<P>
    Bq27441Host { dev: dev }

impl PowerManagerAsync[hw, time] for Bq27441Host
    @tier(app)
    async fn battery_measure(self) -> ?BatteryReading [hw, time]
        for _i in 0..INIT_POLLS
            let cs = control_status(self.dev)
            if cs == None
                return None
            if ((cs ?? 0) & CTRL_INITCOMP) != 0
                break
            core.rt.sleep_ms(100)
        battery_read(self.dev)
